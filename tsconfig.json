{
  "files": [],
  "references": [
    { "path": "./packages/ui/tsconfig.json" },
    { "path": "./packages/web/tsconfig.json" },
    { "path": "./packages/electron/tsconfig.json" },
    { "path": "./packages/agent-protocol/tsconfig.json" }
  ],
  "compilerOptions": {
    "baseUrl": ".",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "paths": {
      "@ompchamber/ui/*": ["./packages/ui/src/*"],
      "@ompchamber/web/*": ["./packages/web/src/*"],
      "@ompchamber/agent-protocol": ["./packages/agent-protocol/src/index.ts"],
      "@ompchamber/agent-protocol/*": ["./packages/agent-protocol/src/*"]
    }
  }
}
