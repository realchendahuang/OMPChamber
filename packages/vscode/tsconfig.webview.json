{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "types": ["vite/client", "@types/dom-speech-recognition"],
    "paths": {
      "@/*": ["../ui/src/*"],
      "@vscode/*": ["./webview/*"],
      "@ompchamber/ui/*": ["../ui/src/*"],
      "@ompchamber/agent-protocol": ["../agent-protocol/src/index.ts"],
      "@ompchamber/agent-protocol/*": ["../agent-protocol/src/*"]
    }
  },
  "include": ["webview/**/*", "../ui/src/**/*"]
}
